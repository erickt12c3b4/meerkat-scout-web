# Copy to .env.local. All values are optional; the site runs without them (forms fall back to mailto:).

# Public site origin (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://meerkatscout.com

# Google reCAPTCHA v2 (checkbox on /contact, invisible on /demo).
# Default when unset is Google's public TEST key: always passes and shows a "for testing purposes only" banner.
# Register the production domain in the reCAPTCHA admin console and set both before launch.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Where /api/lead forwards verified demo leads (CRM webhook, JSON POST). Empty = log only.
LEAD_ENDPOINT=

# Booking page embedded after a successful demo request. Cal.com recommended (prefills name/email/notes).
# Empty = "we'll email you times" fallback. Calendly and Google Calendar appointment pages also work.
NEXT_PUBLIC_SCHEDULER_URL=

# App login URL for the header "Sign in" link. Empty = "#signin" stub.
NEXT_PUBLIC_SIGN_IN_URL=

# Set to "false" to disable reCAPTCHA on both forms (development only).
NEXT_PUBLIC_HUMAN_CHECK=true
